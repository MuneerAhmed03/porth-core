{
  "name": "porth",
  "version": "0.1.0",
  "description": "Durable local storage and SQLite for Vite apps on the web and Android",
  "type": "module",
  "main": "./dist/porth.umd.cjs",
  "module": "./dist/porth.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/porth.js",
      "require": "./dist/porth.umd.cjs"
    },
    "./drizzle": {
      "types": "./dist/drizzle/index.d.ts",
      "import": "./dist/drizzle.js",
      "require": "./dist/drizzle.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MuneerAhmed03/porth-core.git"
  },
  "homepage": "https://github.com/MuneerAhmed03/porth#readme",
  "bugs": {
    "url": "https://github.com/MuneerAhmed03/porth/issues"
  },
  "keywords": [
    "vite",
    "android",
    "sqlite",
    "indexeddb",
    "drizzle",
    "offline-first"
  ],
  "scripts": {
    "build": "vite build && vite build --mode drizzle",
    "dev": "vite build --watch",
    "test": "vitest"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.45.0 <1.0.0"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    }
  },
  "devDependencies": {
    "drizzle-orm": "^0.45.2",
    "fake-indexeddb": "^6.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.7.0",
    "vitest": "^1.0.0"
  }
}
